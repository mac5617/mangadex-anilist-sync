# Copy to .env and fill in. .env is git-ignored; never commit it.

# --- MangaDex personal API client (mangadex.org/settings -> API Clients) ---
MANGADEX_USERNAME=
MANGADEX_PASSWORD=
MANGADEX_CLIENT_ID=
MANGADEX_CLIENT_SECRET=

# --- AniList API client (anilist.co -> Settings -> Developer) ---
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Must match the redirect URL registered on AniList exactly.
ANILIST_REDIRECT_URI=http://127.0.0.1:8765/auth/anilist/callback
# Written by the app after you connect AniList. Valid for one year.
ANILIST_ACCESS_TOKEN=

# --- MyAnimeList API client (myanimelist.net/apiconfig -> Create ID) ---
# App type "web" gives a client secret; "other" gives none (leave it empty).
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
# Must match the App Redirect URL registered on MyAnimeList exactly.
MAL_REDIRECT_URI=http://127.0.0.1:8765/auth/mal/callback

# --- Optional ---
# Ollama, for the recommendation write-ups. Default: http://127.0.0.1:11434
OLLAMA_URL=
# Database location. Default: %LOCALAPPDATA%\mangadex-anilist-sync\sync.db
MDAL_DB_PATH=
# Local port. The server always binds to 127.0.0.1.
MDAL_PORT=8765
